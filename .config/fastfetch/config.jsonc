// TNFX minimal: small line-art CachyOS logo in one soft accent, dim keys, plain values.
// Ten rows so the text block matches the logo height.
{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    "logo": {
        "type": "file",
        "source": "~/.config/fastfetch/logo.txt",
        "color": { "1": "36" },
        "padding": { "top": 1, "left": 3, "right": 5 }
    },
    "display": {
        "separator": "  ",
        "key": { "width": 9 },
        "color": { "keys": "90", "output": "default", "separator": "90" }
    },
    "modules": [
        { "type": "title", "format": "{#36}{user-name}{#90}@{#36}{host-name}" },
        { "type": "custom", "format": "{#90}─────────────────────" },
        { "type": "os",       "key": "os",     "format": "{pretty-name}" },
        { "type": "kernel",   "key": "kernel", "format": "{release}" },
        { "type": "uptime",   "key": "uptime" },
        { "type": "packages", "key": "pkgs",   "format": "{pacman} pacman, {flatpak-all} flatpak" },
        { "type": "wm",       "key": "wm",     "format": "{pretty-name}" },
        { "type": "terminal", "key": "term",   "format": "{pretty-name}" },
        { "type": "shell",    "key": "shell",  "format": "{pretty-name}" },
        { "type": "cpu",      "key": "cpu",    "format": "{name}" },
        { "type": "gpu",      "key": "gpu",    "format": "{name}" },
        { "type": "memory",   "key": "mem",    "format": "{used} / {total}" }
    ]
}
