// Tree style. Colors are ANSI slots, which kitty takes from end-4's wallpaper palette, so they follow the theme.
{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    "logo": {
        "type": "kitty-direct",
        "source": "~/.config/fastfetch/logo-themed.png",
        "width": 24,
        "height": 12,
        "padding": {
            "top": 1,
            "left": 2,
            "right": 3
        }
    },
    "display": {
        "separator": "",
        "key": {
            "width": 14
        },
        "color": {
            "separator": "90",
            "output": "37"
        }
    },
    "modules": [
        "break",
        {
            "type": "title",
            "format": "{#1}{#38;2;211;214;133}{user-name}{#0}{#90} @ {#1}{#38;2;233;235;194}{host-name}"
        },
        {
            "type": "custom",
            "format": "{#90}│"
        },
        {
            "type": "os",
            "key": "├─  os",
            "keyColor": "#D3D685",
            "format": "{pretty-name}"
        },
        {
            "type": "kernel",
            "key": "├─  kernel",
            "keyColor": "#E9EBC2",
            "format": "{release}"
        },
        {
            "type": "uptime",
            "key": "├─ 󰅐 uptime",
            "keyColor": "#D3D685"
        },
        {
            "type": "packages",
            "key": "├─ 󰏖 pkgs",
            "keyColor": "#E9EBC2",
            "format": "{pacman}"
        },
        {
            "type": "wm",
            "key": "├─  wm",
            "keyColor": "#D3D685",
            "format": "{pretty-name}"
        },
        {
            "type": "shell",
            "key": "├─  shell",
            "keyColor": "#E9EBC2",
            "format": "{pretty-name}"
        },
        {
            "type": "terminal",
            "key": "├─  term",
            "keyColor": "#D3D685",
            "format": "{pretty-name}"
        },
        {
            "type": "cpu",
            "key": "├─  cpu",
            "keyColor": "#E9EBC2",
            "format": "{name}"
        },
        {
            "type": "gpu",
            "key": "├─ 󰍛 gpu",
            "keyColor": "#D3D685",
            "format": "{name}"
        },
        {
            "type": "memory",
            "key": "╰─  mem",
            "keyColor": "#E9EBC2",
            "format": "{used} / {total}"
        },
        "break",
        {
            "type": "colors",
            "symbol": "circle",
            "paddingLeft": 2
        }
    ]
}
