// TNFX: shaded CachyOS logo on the left, TNFX banner over a plain info list on the right.
// Logo shades and banner are cyan/blue only.
{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    "logo": {
        "type": "file",
        "source": "~/.config/fastfetch/logo.txt",
        "color": { "1": "36", "2": "34" },
        "padding": { "top": 0, "left": 2, "right": 4 }
    },
    "display": {
        "separator": "  ",
        "key": { "width": 9 },
        "color": { "keys": "90", "output": "default", "separator": "90" }
    },
    "modules": [
        "break",
        { "type": "custom", "format": "{#36}████████ ███    ██ ███████ ██   ██" },
        { "type": "custom", "format": "{#36}   ██    ████   ██ ██       ██ ██" },
        { "type": "custom", "format": "{#36}   ██    ██ ██  ██ █████     ███" },
        { "type": "custom", "format": "{#34}   ██    ██  ██ ██ ██       ██ ██" },
        { "type": "custom", "format": "{#34}   ██    ██   ████ ██      ██   ██" },
        "break",
        { "type": "title", "format": "{#90}{user-name}@{host-name}" },
        { "type": "custom", "format": "{#90}──────────────────────────────────" },
        { "type": "os",       "key": "os",     "format": "{pretty-name}" },
        { "type": "kernel",   "key": "kernel", "format": "{release}" },
        { "type": "uptime",   "key": "uptime" },
        { "type": "packages", "key": "pkgs",   "format": "{pacman} pacman, {flatpak-all} flatpak" },
        { "type": "wm",       "key": "wm",     "format": "{pretty-name}" },
        { "type": "terminal", "key": "term",   "format": "{pretty-name}" },
        { "type": "shell",    "key": "shell",  "format": "{pretty-name}" },
        { "type": "cpu",      "key": "cpu",    "format": "{name}" },
        { "type": "gpu",      "key": "gpu",    "format": "{name}" },
        { "type": "memory",   "key": "mem",    "format": "{used} / {total}" }
    ]
}
